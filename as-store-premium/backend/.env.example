DATABASE_URL=postgresql://user:password@host:6543/postgres
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://pinky-sales.vercel.app
PORT=5000
PG_POOL_MAX=5
SEED_DEFAULT_ADMIN=false

# Supabase 1GB Free Storage (Recommended / Already connected to your DB)
SUPABASE_URL=https://hnntlrycgywhstbqqmfo.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=product-images

# Cloudflare R2 Image Storage Configuration (Optional Free 10GB Tier)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=as-store-images
R2_PUBLIC_URL=https://pub-your-bucket-hash.r2.dev
